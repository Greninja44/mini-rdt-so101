[Unit]
Description=MiniRDT optimization scaling study (stage runner)
After=default.target

[Service]
Type=simple
WorkingDirectory=/home/batman/mini-rdt-so101
ExecStart=/bin/bash /home/batman/mini-rdt-so101/scripts/experiments/run_optimization_service.sh
Restart=on-failure
RestartSec=30
KillMode=control-group
TimeoutStopSec=180

[Install]
WantedBy=default.target
